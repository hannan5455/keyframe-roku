<?xml version="1.0" encoding="utf-8" ?>
<component name="AlbumPicker" extends="Scene">
  <interface>
    <!-- Set "current" before "albums" so the right row is checked -->
    <field id="current" type="integer" value="0" />
    <field id="albums" type="stringarray" onChange="onAlbums" />
    <field id="chosen" type="integer" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/AlbumPicker.brs" />

  <children>
    <Rectangle width="1920" height="1080" color="0x1A1030FF" />

    <Label id="title" translation="[160, 90]" width="1600"
           text="Keyframe: choose an album" font="font:LargeBoldSystemFont" />
    <Label id="hint" translation="[160, 160]" width="1600"
           text="Looking for folders on the USB drive..." />

    <RadioButtonList id="list" translation="[160, 250]"
                     itemSize="[1600, 64]" numRows="11" checkOnSelect="true" />
  </children>
</component>
